# Copy this file to .env and fill in values.

# Local dev (matches docker-compose.yml):
DATABASE_URL="postgresql://docslite:docslite@localhost:5432/docslite?schema=public"

# In production (Vercel), DATABASE_URL is injected automatically when you
# connect a Vercel Postgres (Neon) database to the project.

# Secret used to sign the mock-auth session cookie. Any random string works for this project.
SESSION_SECRET="dev-only-secret-change-me"
